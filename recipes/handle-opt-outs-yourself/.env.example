SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The purchased number your sends go out from. Required.
SMS_FROM=+1XXXXXXXXXX

# Dashboard > API Credentials > Signing Key. The handler refuses an inbound
# webhook without SignalWire's signature, so a forged START cannot undo a STOP.
SIGNALWIRE_SIGNING_KEY=your_signing_key_here

# The inbound webhook URL exactly as configured on the number. Required.
INBOUND_URL=https://<your-host>/inbound

# Local port for the Flask app.
PORT=8080
