# AgentBase serves its SWML behind basic auth. Without these the SDK
# generates a password that lives only in the running process, so the
# number's webhook gets a 401 and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# Local port for the agent server.
PORT=3000

# Turn-taking. Each value below is this recipe's setting, and the schema's
# default where it states one; see the params reference for the meaning and
# the bundled schema for the bounds. ENABLE_BARGE=false turns barging off.
ENABLE_BARGE=complete,partial
BARGE_MIN_WORDS=3
TRANSPARENT_BARGE=true
INTERRUPT_ON_NOISE=false
STATIC_GREETING_NO_BARGE=true
END_OF_SPEECH_TIMEOUT=700
FIRST_WORD_TIMEOUT=1000
SPEECH_EVENT_TIMEOUT=1400
ENERGY_LEVEL=52
ENABLE_TURN_DETECTION=true
