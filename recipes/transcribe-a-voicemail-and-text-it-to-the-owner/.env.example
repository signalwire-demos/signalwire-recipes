SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# where this app is reachable; the transcribeCallback URL is built from it
PUBLIC_URL=https://your-host.example.com

# who reads the voicemail, and the messaging number the text comes from
OWNER_NUMBER=+15550100001
SMS_FROM=+15550001111

# the project's signing key, from the Dashboard; the callback is refused
# unless SignalWire signed it with this
SIGNALWIRE_SIGNING_KEY=your_signing_key_here

# one marker file per transcription already texted; a stand-in for the unique
# key your table would use
SEEN_DIR=voicemails-seen

# the server listens here
PORT=8080
