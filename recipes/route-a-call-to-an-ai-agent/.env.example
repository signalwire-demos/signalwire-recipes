SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# Where your agent serves its SWML.
AGENT_URL=https://your-host.example.com/agent

# The phone route to bind, from the number you already own.
PHONE_ROUTE_ID=00000000-0000-0000-0000-000000000000

# A second URL for SignalWire to try if the primary request fails.
# Host it apart from the agent, or it shares the outage it covers.
FALLBACK_URL=https://fallback.example.com/agent
