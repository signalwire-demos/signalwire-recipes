# Dashboard > API Credentials > Signing Key > Show. Required.
SIGNALWIRE_SIGNING_KEY=your_signing_key_here

# The webhook URL as SignalWire will post to it, without a query string; the
# app appends each request's own query before checking, and refuses to start
# with one configured here. Required.
WEBHOOK_URL=https://<your-host>/webhook

# Local port for the Flask app.
PORT=8080
