SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
# the token needs the Chat scope; it never leaves this server
SIGNALWIRE_API_TOKEN=your_api_token_here

# the URL your agent serves its SWML from, with its basic-auth pair, as in
# run-the-same-agent-over-text. Injected on every create and never accepted
# from the page, so a visitor cannot choose which agent runs.
AGENT_CONFIG_URL=https://recipes:change_me@abc123.ngrok-free.app/front-desk/

# the publishable key the page carries in Authorization: Bearer. Public by
# design; rotate it by changing this value and redeploying.
CHAT_GATEWAY_KEY=pk_change_me

# signs the per-visitor handle so a conversation id cannot be forged or
# guessed. Keep it stable across restarts and replicas, or open chats die.
CHAT_GATEWAY_SECRET=change_me_to_a_long_random_string

# origins allowed to use the key, comma separated; localhost is always allowed.
# Leak containment for a key pasted into someone else's page, not access control.
ALLOWED_ORIGINS=https://www.example.com

# what a leaked key can cost you: new conversations per window, and turns per
# conversation. Counters live in this process.
MAX_NEW_CONVERSATIONS=60
WINDOW_SECONDS=60
MAX_TURNS=200

# idle seconds before the service ends a conversation (service default 3600)
CONVERSATION_TIMEOUT=1800

# the gateway and the page listen here
PORT=8080
