SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# A number on your project the call comes from. Required.
CALL_FROM=+1XXXXXXXXXX

# The cXML the call runs once answered: any cXML bin in your space. Required.
CALL_URL=https://<your-space>.signalwire.com/laml-bins/<id>

# SignalWire posts the callbacks you asked for here: this app's /status behind your tunnel. Required.
STATUS_CALLBACK_URL=https://<your-host>/status

# Local port for the Flask app.
PORT=8080
