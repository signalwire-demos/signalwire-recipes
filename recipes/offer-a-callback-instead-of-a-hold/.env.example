SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The number the callback comes from.
SIGNALWIRE_PHONE_NUMBER=+15550001111

# The queue callers wait in.
QUEUE_NAME=support

# How long anyone waits before being offered the way out, in seconds.
MAX_WAIT_SECONDS=180

# Base URL for the hold music and status callbacks.
PUBLIC_URL=https://your-host.example.com

# Local port for the Flask app.
PORT=8080
