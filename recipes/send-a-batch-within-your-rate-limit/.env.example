SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The purchased number the batch goes out from. Required.
SMS_FROM=+1XXXXXXXXXX

# Its kind, which sets the rate: 10dlc (4/s), toll-free (3/s) or short-code (10/s).
NUMBER_TYPE=10dlc
