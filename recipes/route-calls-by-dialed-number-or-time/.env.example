# Basic auth on the webhook. Put the same pair in the webhook URL you give
# SignalWire (https://user:password@host/swml). Required: without them the
# route refuses to start, because a webhook anyone can fetch is a webhook
# anyone can impersonate you against.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=change-me-to-a-long-random-string

# Seconds to ring the line's destination before giving up.
CONNECT_TIMEOUT=25

# Local port for the Flask app.
PORT=8080
