# AgentBase serves its SWML behind basic auth, in Lambda mode too. Without
# these the SDK generates a password that lives only in the running process,
# so the number's webhook gets a 401 and the password changes on every start.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# Required for a deployment, and only there. The SDK renders every tool's
# web_hook_url and post_prompt_url from this base; without it the URLs point
# at a host the function does not have, and every tool call fails. Leave it
# unset for a local run, or local tool calls go to API Gateway instead.
# SWML_PROXY_URL_BASE=https://<api-id>.execute-api.<region>.amazonaws.com

# Local port when nothing selects a serverless mode.
PORT=3000
