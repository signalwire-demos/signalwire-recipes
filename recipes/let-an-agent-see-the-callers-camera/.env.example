# AgentBase serves its SWML behind basic auth. Without these the SDK
# generates a password that lives only in the running process. The webhook
# then gets a 401, and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# One of the schema's documented values: gpt-4o-mini, gpt-4.1-mini, gpt-4.1-nano.
VISION_MODEL=gpt-4o-mini

# Local port for the agent server.
PORT=3000
