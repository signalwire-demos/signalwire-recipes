SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# your system of record: the endpoint the call POSTs the caller's number to.
# It must answer with JSON carrying a `tier`.
CRM_URL=https://crm.example.com/lookup
CRM_TOKEN=replace-me

# where each tier lands, E.164
GOLD_NUMBER=+15550100001
STANDARD_NUMBER=+15550100002
