SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The voice-enabled number the call comes from.
SIGNALWIRE_PHONE_NUMBER=+15550001111

# Base URL for the lifecycle callbacks (status_url).
PUBLIC_URL=https://your-host.example.com

# AgentBase renders webhook URLs with basic auth even when the document is
# inlined. Set them so the rendered credentials are yours, not generated.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long
