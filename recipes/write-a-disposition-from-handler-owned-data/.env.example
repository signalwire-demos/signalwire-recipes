# AgentBase serves its SWML behind basic auth. Without these the SDK
# generates a password that lives only in the running process, so the
# number's webhook gets a 401 and the password changes on every restart.
# The platform sends the end-of-call POST to post_prompt_url with the same
# credentials, so they gate the disposition too.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# A lead qualifies at or above this budget, in whole dollars, when the
# caller can also sign.
MIN_BUDGET=5000

# Local port for the agent server.
PORT=3000
