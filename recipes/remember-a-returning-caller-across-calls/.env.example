SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# the agent serves its document behind basic auth; without these the SDK
# invents a password that exists only in the running process
SWML_BASIC_AUTH_USER=recipes
SWML_BASIC_AUTH_PASSWORD=change_me

# where each caller's last summary lives; a stand-in for your database
MEMORY_PATH=caller-memory.json

# the agent listens here
PORT=3000

# TypeScript only: the post-prompt handler's port, and the public URL the
# platform posts to. The code adds the basic auth credentials above to the
# URL, because the platform gets only the URL. Set it to your host on deploy.
POST_PROMPT_PORT=3001
# POST_PROMPT_URL=https://your-host/post_prompt
