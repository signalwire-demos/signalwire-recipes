SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The running agent's public SWML URL, with its basic-auth pair: the
# SWML_BASIC_AUTH_USER and SWML_BASIC_AUTH_PASSWORD from the agent's own .env.
# This script has no agent of its own, so those two live over there. Required.
AGENT_URL=https://<user>:<password>@<your-host>/front-desk/

# How long a guest token stays valid, in seconds.
TOKEN_TTL_SECONDS=900
