# For create-room.
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# The room join_room names; create-room makes it.
ROOM_NAME=workshop-standup

# SWMLService serves its document behind basic auth. Without these the SDK
# generates a password that lives only in the running process. The number's
# webhook then gets a 401, and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# Local port for the SWML server.
PORT=8080
