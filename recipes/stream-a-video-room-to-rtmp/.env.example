SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# Where the room's video goes: an rtmp:// or rtmps:// server that accepts the
# stream. It may contain a stream key. Required for `start`.
RTMP_URL=rtmps://live.example.com/app/your-stream-key
