# AgentBase serves its SWML behind basic auth. Without these the SDK
# generates a password that lives only in the running process, so the
# number's webhook gets a 401 and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# A hosted MP3 the platform can fetch, looped while the tool is running.
# This app does not serve audio itself. Leave empty to attach no wait file;
# the filler phrase still plays.
WAIT_FILE_URL=

# Artificial delay on the stock lookup, in seconds, so you can hear the gap
# being covered on a real call. Leave at 0 in production.
LOOKUP_DELAY_SECONDS=0

# Local port for the agent server.
PORT=3000
