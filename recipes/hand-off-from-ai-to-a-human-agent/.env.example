SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# AgentBase serves its SWML behind basic auth. Without these the SDK
# generates a password that lives only in the running process. The webhook
# then gets a 401, and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long

# The queue the agent hands callers to; enter_queue creates it by name on
# first use.
QUEUE_NAME=support

# Its id, for the brief command. GET /api/relay/rest/queues lists your queues
# with id and friendly_name; copy the id of the one above once it exists.
QUEUE_ID=

# The port the human's document is served on by python app.py take.
TAKE_PORT=3001

# Local port for the agent server.
PORT=3000

# where the agent files its hand-off notes for the brief command to read
# NOTES_PATH=handoff-notes.json
