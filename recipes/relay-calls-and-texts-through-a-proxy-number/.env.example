SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# the number both parties see; a purchased number on this project
PROXY_NUMBER=+15550001111

# both webhooks serve documents behind basic auth; put user:pass in the URLs
SWML_BASIC_AUTH_USER=recipes
SWML_BASIC_AUTH_PASSWORD=change_me

# your own systems present this as X-Proxy-Key to POST /pair. Without it,
# anyone who can reach the server could route strangers to your users
PROXY_ADMIN_KEY=change_me_too

# where the pairings live; a stand-in for your database
SESSIONS_PATH=proxy-sessions.json

# the server listens here
PORT=8080
