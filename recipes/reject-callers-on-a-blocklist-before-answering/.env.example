SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# the agent serves its document behind basic auth; without these the SDK
# invents a password that exists only in the running process
SWML_BASIC_AUTH_USER=recipes
SWML_BASIC_AUTH_PASSWORD=change_me

# where an allowed call goes, and the hangup reason a blocked one gets:
# hangup, busy or decline
DESTINATION=+15550100001
REJECT_REASON=decline

# the server listens here
PORT=8080
