SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# Where SignalWire may post the transcript callback: this app's /transcripts
# behind your tunnel, exactly as you pass it. Required.
TRANSCRIBE_STATUS_URL=https://<your-host>/transcripts

# Dashboard > API Credentials > Signing Key. The status route refuses a
# callback without SignalWire's signature. Required.
SIGNALWIRE_SIGNING_KEY=your_signing_key_here

# Your own token for reading transcripts back: Authorization: Bearer <this>. Required.
READ_TOKEN=choose-something-long

# Local port for the Flask app.
PORT=8080
