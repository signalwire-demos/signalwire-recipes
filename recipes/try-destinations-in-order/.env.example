# Destinations to ring, in order. Phone numbers in E.164 form, SIP URIs and
# Resource addresses can be mixed. The parallel variant skips SIP entries.
DESTINATIONS=+15550100001,sip:workshop@pbx.example.com,+15550100003

# Seconds to ring each destination before moving to the next.
RING_SECONDS=15

# Local port for the SWML server.
PORT=8080

# SWMLService serves its document behind basic auth. Without these the SDK
# generates a password that lives only in the running process, so the
# number's webhook gets a 401 and the password changes on every restart.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=choose-something-long
