# The publicly reachable base URL of this app. SignalWire POSTs translation
# events to <PUBLIC_URL>/translation.
PUBLIC_URL=https://your-host.example.com

# The party the caller is bridged to.
AGENT_NUMBER=+15550100001

# The language pair, and the voice each side hears the other in.
FROM_LANG=en-US
TO_LANG=es-ES
FROM_VOICE=Polly.Joanna
TO_VOICE=Polly.Lucia

# Local port for the Flask app.
PORT=8080
