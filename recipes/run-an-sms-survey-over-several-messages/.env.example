SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# the number the survey texts from. Its message handler points at this app
SMS_FROM=+15550001111

# the public URL of the /inbound route, exactly as SignalWire will call it.
# The webhook signature is computed over this URL plus the body
INBOUND_URL=https://your-host/inbound

# the signing key from the create-project response or your Dashboard
SIGNALWIRE_SIGNING_KEY=your_signing_key_here

# your own systems present this as X-Survey-Key to POST /begin. Without it,
# anyone who can reach the server could text anyone at your expense
SURVEY_ADMIN_KEY=change_me
