# Your space, project and API token. The server uses them to mint tokens;
# the browser never sees them.
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here
# The room's name. Its address is /public/<name>. Create the room first with
# create-a-video-room-and-join-from-the-browser.
ROOM_NAME=team-standup
# Where the Flask app listens.
PORT=8080
